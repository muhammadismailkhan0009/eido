function main() returns Int {
    var mode = Process.argument(0);
    if (mode == "typed") { return typed(); }
    if (mode == "raw") { return rawView(); }
    if (mode == "churn") { return churn(); }
    if (mode == "reuse") { return reuse(); }
    if (mode == "placement") { return placement(); }
    return -1;
}
