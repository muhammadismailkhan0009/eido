  "candidate_patch": "diff --git a/stdlib/native/nim/eido_storage.nim b/stdlib/native/nim/eido_storage.nim\nindex 136cf55..11c4f36 100644\n--- a/stdlib/native/nim/eido_storage.nim\n+++ b/stdlib/native/nim/eido_storage.nim\n@@ -2,6 +2,12 @@\n ## private representation bridges used by the SDK Eido Storage<T> wrapper.\n ## Handles are allocation-free values; owning allocation operations alone acquire backing memory.\n \n+# Hosted physical backing only; all ownership and alignment remain unchanged.\n+proc systemAllocate(count, size: csize_t): pointer\n+  {.importc: \"calloc\", header: \"<stdlib.h>\".}\n+proc systemRelease(address: pointer)\n+  {.importc: \"free\", header: \"<stdlib.h>\".}\n+\n type\n   EidoStorage*[T] = object\n     data*: ptr UncheckedArray[T]\n@@ -73,7 +79,7 @@ proc eidoStorageAllocateRaw*(\n     return\n \n   let byteCount = int(allocations * bytesPerAllocation)\n-  result.data = cast[ptr UncheckedArray[int8]](alloc0(byteCount))\n+  result.data = cast[ptr UncheckedArray[int8]](systemAllocate(1, csize_t(byteCount)))\n   if result.data.isNil:\n     raise newException(OutOfMemDefect, \"Eido raw storage allocation failed\")\n \n@@ -183,7 +189,7 @@ proc eidoStorageAlignment*[T](): int64 =\n ## Single physical native deallocation operation.\n proc releaseNativeBacking(base: pointer) =\n   if not base.isNil:\n-    dealloc(base)\n+    systemRelease(base)\n \n ## Trusted SDK-only release of an original native allocation base.\n ## This never constructs an owning or readable descriptor from an address.\n",
  "decision": "Deferred and reverted: strong memory-retention and peak-RSS advantage, but general-purpose replacement fails performance trade-off (small allocation churn and fully touched large allocation trace regress substantially).",
