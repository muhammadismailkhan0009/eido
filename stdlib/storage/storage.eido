// Typed Storage is ordinary Eido orchestration over the compiler-provided raw Storage<Byte> capability.
class Storage<T> {
    function allocate(Int allocations) returns Storage<T> {
        // The compiler provides only raw native allocation. Typed placement,
        // including over-alignment, is Eido library code.
        require {
            allocations >= 0;
            Storage<T>.size() > 0;
            Alignment.isPowerOfTwo(Storage<T>.alignment());
            allocations <= (9223372036854775807 - Storage<T>.alignment() + 1) /
                Storage<T>.size();
        }
        var stride = Storage<T>.size();
        var alignment = Storage<T>.alignment();
        if (allocations == 0) {
            return Storage<T>.compilerFromRaw(
                Storage<Byte>.allocateRaw(0, stride)
            );
        }
        var raw = Storage<Byte>.allocateRaw(
            1, allocations * stride + alignment - 1
        );
        var alignedAddress = Alignment.alignUp(
            Storage<Byte>.address(raw), alignment
        );
        var aligned = Storage<Byte>.compilerRebaseOwned(
            raw, alignedAddress, allocations, stride
        );
        return Storage<T>.compilerFromRaw(aligned);
    }

    // Explicit placement inside existing RAM. This claims a Storage handle,
    // not backing ownership; release invalidates the handle without freeing RAM.
    // Caller/region allocator coordinates overlap and lifetime.
    function reserveAt(
        Storage<Byte> region, Int address, Int count
    ) returns Storage<T> {
        require {
            count >= 0;
            Alignment.isAligned(address, Storage<T>.alignment());
        }
        var raw = Storage<Byte>.compilerReserveAt(
            region, address, count, Storage<T>.size()
        );
        return Storage<T>.compilerFromRaw(raw);
    }

    function view(Storage<Byte> raw, Int start) returns Storage<T> {
        var borrowed = Storage<Byte>.view(raw, start);
        return Storage<T>.compilerFromRaw(borrowed);
    }

    function viewAt(Storage<Byte> raw, Int byteOffset) returns Storage<T> {
        var borrowed = Storage<Byte>.viewAt(raw, byteOffset);
        return Storage<T>.compilerFromRaw(borrowed);
    }

    function slice(Storage<T> storage, Int start, Int count) returns Storage<T> {
        var raw = Storage<T>.compilerRaw(storage);
        var borrowed = Storage<Byte>.slice(raw, start, count);
        return Storage<T>.compilerFromRaw(borrowed);
    }

    function capacity(Storage<T> storage) returns Int {
        return Storage<Byte>.capacity(Storage<T>.compilerRaw(storage));
    }

    /// Distance in bytes between consecutive slots in a live Storage view.
    function strideBytes(Storage<T> storage) returns Int {
        return Storage<Byte>.strideBytes(Storage<T>.compilerRaw(storage));
    }

    function address(Storage<T> storage) returns Int {
        return Storage<Byte>.address(Storage<T>.compilerRaw(storage));
    }

    function read(Storage<T> storage, Int index) returns T {
        return Storage<T>.compilerRead(storage, index);
    }

    function write(Storage<T> storage, Int index, T value) {
        Storage<T>.compilerWrite(storage, index, value);
    }

    function release(Storage<T> storage) {
        var raw = Storage<T>.compilerRaw(storage);
        Storage<Byte>.release(raw);
    }

    native function size() returns Int;
    native function alignment() returns Int;
}
