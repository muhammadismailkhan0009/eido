// Compiler-private managed-memory runtime policy written in Eido over Storage.
class ManagedGcRuntime {
    Int ManagedGcRuntime.heapHead = 0;
    Int ManagedGcRuntime.collectionThreshold = 64;
    Int ManagedGcRuntime.temporaryDepth = 0;

    function alignUp(Int value, Int alignment) returns Int {
        return ((value + alignment - 1) / alignment) * alignment;
    }

    function headerAlignment() returns Int {
        var alignment = Storage<Int>.alignment();
        if (Storage<Bool>.alignment() > alignment) {
            set alignment = Storage<Bool>.alignment();
        }
        return alignment;
    }

    function nextOffset() returns Int { return 0; }
    function markedOffset() returns Int {
        return ManagedGcRuntime.alignUp(Storage<Int>.size(), Storage<Bool>.alignment());
    }
    function invariantDepthOffset() returns Int {
        return ManagedGcRuntime.alignUp(
            ManagedGcRuntime.markedOffset() + Storage<Bool>.size(),
            Storage<Int>.alignment()
        );
    }
    function payloadOffsetFieldOffset() returns Int {
        return ManagedGcRuntime.invariantDepthOffset() + Storage<Int>.size();
    }
    function payloadSizeOffset() returns Int {
        return ManagedGcRuntime.payloadOffsetFieldOffset() + Storage<Int>.size();
    }
    function totalSizeOffset() returns Int {
        return ManagedGcRuntime.payloadSizeOffset() + Storage<Int>.size();
    }
    function typeIdOffset() returns Int {
        return ManagedGcRuntime.totalSizeOffset() + Storage<Int>.size();
    }
    function headerSize() returns Int {
        return ManagedGcRuntime.alignUp(
            ManagedGcRuntime.typeIdOffset() + Storage<Int>.size(),
            ManagedGcRuntime.headerAlignment()
        );
    }

    function headerAddress(Int identity) returns Int {
        var backlinkRaw = Storage<Byte>.fromAddress(
            identity - Storage<Int>.size(),
            1,
            Storage<Int>.size()
        );
        var backlink = Storage<Int>.view(backlinkRaw, 0);
        return Storage<Int>.read(backlink, 0);
    }
    function header(Int identity) returns Storage<Byte> {
        return Storage<Byte>.fromAddress(
            ManagedGcRuntime.headerAddress(identity),
            1,
            ManagedGcRuntime.headerSize()
        );
    }
    function readInt(Int identity, Int offset) returns Int {
        var raw = ManagedGcRuntime.header(identity);
        var slot = Storage<Int>.viewAt(raw, offset);
        return Storage<Int>.read(slot, 0);
    }
    function writeInt(Int identity, Int offset, Int value) {
        var raw = ManagedGcRuntime.header(identity);
        var slot = Storage<Int>.viewAt(raw, offset);
        Storage<Int>.write(slot, 0, value);
    }
    function readBool(Int identity, Int offset) returns Bool {
        var raw = ManagedGcRuntime.header(identity);
        var slot = Storage<Bool>.viewAt(raw, offset);
        return Storage<Bool>.read(slot, 0);
    }
    function writeBool(Int identity, Int offset, Bool value) {
        var raw = ManagedGcRuntime.header(identity);
        var slot = Storage<Bool>.viewAt(raw, offset);
        Storage<Bool>.write(slot, 0, value);
    }

    function initializeHeader(
        Storage<Byte> backing,
        Int payloadOffset,
        Int payloadSize,
        Int totalSize,
        Int typeId
    ) returns Int {
        var allocation = Storage<Byte>.address(backing);
        var nextSlot = Storage<Int>.viewAt(backing, ManagedGcRuntime.nextOffset());
        Storage<Int>.write(nextSlot, 0, ManagedGcRuntime.heapHead);
        var markedSlot = Storage<Bool>.viewAt(backing, ManagedGcRuntime.markedOffset());
        Storage<Bool>.write(markedSlot, 0, false);
        var invariantSlot = Storage<Int>.viewAt(backing, ManagedGcRuntime.invariantDepthOffset());
        Storage<Int>.write(invariantSlot, 0, 0);
        var payloadOffsetSlot = Storage<Int>.viewAt(backing, ManagedGcRuntime.payloadOffsetFieldOffset());
        Storage<Int>.write(payloadOffsetSlot, 0, payloadOffset);
        var payloadSizeSlot = Storage<Int>.viewAt(backing, ManagedGcRuntime.payloadSizeOffset());
        Storage<Int>.write(payloadSizeSlot, 0, payloadSize);
        var totalSizeSlot = Storage<Int>.viewAt(backing, ManagedGcRuntime.totalSizeOffset());
        Storage<Int>.write(totalSizeSlot, 0, totalSize);
        var typeSlot = Storage<Int>.viewAt(backing, ManagedGcRuntime.typeIdOffset());
        Storage<Int>.write(typeSlot, 0, typeId);
        var backlink = Storage<Int>.viewAt(
            backing,
            payloadOffset - Storage<Int>.size()
        );
        Storage<Int>.write(backlink, 0, allocation);
        return allocation;
    }

    function allocate(Int payloadSize, Int payloadAlignment, Int typeId) returns Int {
        var effectiveAlignment = payloadAlignment + 0;
        var headerAlignment = ManagedGcRuntime.headerAlignment();
        if (effectiveAlignment < headerAlignment) { set effectiveAlignment = headerAlignment; }
        var payloadOffset = ManagedGcRuntime.alignUp(
            ManagedGcRuntime.headerSize() + Storage<Int>.size(),
            effectiveAlignment
        );
        var totalSize = payloadOffset + payloadSize;
        if (totalSize < 1) { set totalSize = 1; }
        var backing = ManagedHeapAllocator.allocate(totalSize);
        var allocation = ManagedGcRuntime.initializeHeader(
            backing, payloadOffset, payloadSize, totalSize, typeId
        );
        var identity = allocation + payloadOffset;
        set ManagedGcRuntime.heapHead = identity;
        return identity;
    }

    function next(Int allocation) returns Int { return ManagedGcRuntime.readInt(allocation, ManagedGcRuntime.nextOffset()); }
    function setNext(Int allocation, Int nextAllocation) { ManagedGcRuntime.writeInt(allocation, ManagedGcRuntime.nextOffset(), nextAllocation); }
    function marked(Int allocation) returns Bool { return ManagedGcRuntime.readBool(allocation, ManagedGcRuntime.markedOffset()); }
    function setMarked(Int allocation, Bool value) { ManagedGcRuntime.writeBool(allocation, ManagedGcRuntime.markedOffset(), value); }
    function payloadSize(Int allocation) returns Int { return ManagedGcRuntime.readInt(allocation, ManagedGcRuntime.payloadSizeOffset()); }
    function typeId(Int allocation) returns Int { return ManagedGcRuntime.readInt(allocation, ManagedGcRuntime.typeIdOffset()); }

    function mark(Int allocation) {
        if (allocation == 0) { return; }
        if (ManagedGcRuntime.marked(allocation)) { return; }
        ManagedGcRuntime.setMarked(allocation, true);

        var typeId = ManagedGcRuntime.typeId(allocation);
        var count = MemoryTypeRegistry.fieldCount(typeId);
        if (count == 0) { return; }
        var payload = Storage<Byte>.fromAddress(
            allocation,
            1,
            ManagedGcRuntime.payloadSize(allocation)
        );
        var index = 0;
        while (index < count) {
            if (MemoryTypeRegistry.fieldContainsIdentity(typeId, index)) {
                var offset = MemoryTypeRegistry.fieldOffset(typeId, index);
                var slot = Storage<Int>.viewAt(payload, offset);
                ManagedGcRuntime.mark(Storage<Int>.read(slot, 0));
            }
            set index = index + 1;
        }
    }

    function markRoots() {
        var index = 0;
        var limit = MemoryValueRegistry.highWaterMark();
        while (index < limit) {
            if (MemoryValueRegistry.isActive(index)) {
                ManagedGcRuntime.mark(MemoryValueRegistry.valueAt(index));
            }
            set index = index + 1;
        }
    }

    function cleanupPayload(Int allocation) {
        var typeId = ManagedGcRuntime.typeId(allocation);
        var count = MemoryTypeRegistry.fieldCount(typeId);
        if (count == 0) { return; }
        var payload = Storage<Byte>.fromAddress(
            allocation,
            1,
            ManagedGcRuntime.payloadSize(allocation)
        );
        var index = 0;
        while (index < count) {
            var kind = MemoryTypeRegistry.fieldCleanupKind(typeId, index);
            if (kind == 1) {
                var offset = MemoryTypeRegistry.fieldOffset(typeId, index);
                var stringSlot = Storage<String>.viewAt(payload, offset);
                Storage<String>.write(stringSlot, 0, "");
            } else if (kind == 2) {
                var offset = MemoryTypeRegistry.fieldOffset(typeId, index);
                var optionalStringSlot = Storage<String?>.viewAt(payload, offset);
                Storage<String?>.write(optionalStringSlot, 0, none);
            }
            set index = index + 1;
        }
    }

    function sweep() {
        var previous = 0;
        var current = ManagedGcRuntime.heapHead;
        while (current != 0) {
            var nextAllocation = ManagedGcRuntime.next(current);
            if (ManagedGcRuntime.marked(current)) {
                ManagedGcRuntime.setMarked(current, false);
                set previous = current;
            } else {
                if (previous == 0) { set ManagedGcRuntime.heapHead = nextAllocation; }
                else { ManagedGcRuntime.setNext(previous, nextAllocation); }
                ManagedGcRuntime.cleanupPayload(current);
                var totalSize = ManagedGcRuntime.readInt(current, ManagedGcRuntime.totalSizeOffset());
                ManagedHeapAllocator.release(
                    ManagedGcRuntime.headerAddress(current),
                    totalSize
                );
            }
            set current = nextAllocation;
        }
    }

    function collect() {
        ManagedGcRuntime.markRoots();
        ManagedGcRuntime.sweep();
        var nextThreshold = ManagedHeapAllocator.allocationCount() * 2 + 1;
        if (nextThreshold < 64) { set nextThreshold = 64; }
        set ManagedGcRuntime.collectionThreshold = nextThreshold;
    }

    function temporaryEnter() { set ManagedGcRuntime.temporaryDepth = ManagedGcRuntime.temporaryDepth + 1; }
    function temporaryLeave() { set ManagedGcRuntime.temporaryDepth = ManagedGcRuntime.temporaryDepth - 1; }

    function executionBoundary() {
        if (
            ManagedGcRuntime.temporaryDepth == 0 and
            ManagedHeapAllocator.allocationCount() >= ManagedGcRuntime.collectionThreshold
        ) {
            ManagedGcRuntime.collect();
        }
    }

    function invariantEnter(Int allocation) {
        var depth = ManagedGcRuntime.readInt(allocation, ManagedGcRuntime.invariantDepthOffset());
        ManagedGcRuntime.writeInt(allocation, ManagedGcRuntime.invariantDepthOffset(), depth + 1);
    }
    function invariantLeave(Int allocation) {
        var depth = ManagedGcRuntime.readInt(allocation, ManagedGcRuntime.invariantDepthOffset());
        ManagedGcRuntime.writeInt(allocation, ManagedGcRuntime.invariantDepthOffset(), depth - 1);
    }
    function invariantClear(Int allocation) returns Bool {
        return ManagedGcRuntime.readInt(allocation, ManagedGcRuntime.invariantDepthOffset()) == 0;
    }
    function allocationCount() returns Int { return ManagedHeapAllocator.allocationCount(); }

    function shutdown() {
        MemoryValueRegistry.clear();
        ManagedGcRuntime.collect();
        MemoryValueRegistry.shutdown();
        MemoryTypeRegistry.shutdown();
    }
}
