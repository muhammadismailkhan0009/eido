// Generic compiler-provided object-layout metadata backed entirely by Storage.
// Memory policies inspect these facts; the registry itself contains no collector policy.
class MemoryTypeRegistry {
    Storage<Int> MemoryTypeRegistry.fieldStarts = Storage<Int>.allocate(16);
    Storage<Int> MemoryTypeRegistry.fieldCounts = Storage<Int>.allocate(16);
    Storage<Int> MemoryTypeRegistry.fieldOffsets = Storage<Int>.allocate(32);
    Storage<Bool> MemoryTypeRegistry.fieldIdentity = Storage<Bool>.allocate(32);
    Int MemoryTypeRegistry.typeCapacity = 16;
    Int MemoryTypeRegistry.fieldCapacity = 32;
    Int MemoryTypeRegistry.fieldUsed = 0;

    function ensureTypeCapacity(Int required) {
        if (required <= MemoryTypeRegistry.typeCapacity) { return; }
        var newCapacity = MemoryTypeRegistry.typeCapacity * 2;
        while (newCapacity < required) { set newCapacity = newCapacity * 2; }
        var newStarts = Storage<Int>.allocate(newCapacity);
        var newCounts = Storage<Int>.allocate(newCapacity);
        var index = 0;
        while (index < MemoryTypeRegistry.typeCapacity) {
            Storage<Int>.write(newStarts, index, Storage<Int>.read(MemoryTypeRegistry.fieldStarts, index));
            Storage<Int>.write(newCounts, index, Storage<Int>.read(MemoryTypeRegistry.fieldCounts, index));
            set index = index + 1;
        }
        Storage<Int>.release(MemoryTypeRegistry.fieldStarts);
        Storage<Int>.release(MemoryTypeRegistry.fieldCounts);
        set MemoryTypeRegistry.fieldStarts = newStarts;
        set MemoryTypeRegistry.fieldCounts = newCounts;
        set MemoryTypeRegistry.typeCapacity = newCapacity;
    }

    function ensureFieldCapacity(Int required) {
        if (required <= MemoryTypeRegistry.fieldCapacity) { return; }
        var newCapacity = MemoryTypeRegistry.fieldCapacity * 2;
        while (newCapacity < required) { set newCapacity = newCapacity * 2; }
        var newOffsets = Storage<Int>.allocate(newCapacity);
        var newIdentity = Storage<Bool>.allocate(newCapacity);
        var index = 0;
        while (index < MemoryTypeRegistry.fieldUsed) {
            Storage<Int>.write(newOffsets, index, Storage<Int>.read(MemoryTypeRegistry.fieldOffsets, index));
            Storage<Bool>.write(newIdentity, index, Storage<Bool>.read(MemoryTypeRegistry.fieldIdentity, index));
            set index = index + 1;
        }
        Storage<Int>.release(MemoryTypeRegistry.fieldOffsets);
        Storage<Bool>.release(MemoryTypeRegistry.fieldIdentity);
        set MemoryTypeRegistry.fieldOffsets = newOffsets;
        set MemoryTypeRegistry.fieldIdentity = newIdentity;
        set MemoryTypeRegistry.fieldCapacity = newCapacity;
    }

    function registerType(Int typeId, Int fieldCount) {
        require { typeId >= 0; fieldCount >= 0; }
        MemoryTypeRegistry.ensureTypeCapacity(typeId + 1);
        MemoryTypeRegistry.ensureFieldCapacity(MemoryTypeRegistry.fieldUsed + fieldCount);
        Storage<Int>.write(MemoryTypeRegistry.fieldStarts, typeId, MemoryTypeRegistry.fieldUsed);
        Storage<Int>.write(MemoryTypeRegistry.fieldCounts, typeId, fieldCount);
        set MemoryTypeRegistry.fieldUsed = MemoryTypeRegistry.fieldUsed + fieldCount;
    }

    function setField(Int typeId, Int index, Int offset, Bool containsIdentity) {
        require { typeId >= 0; index >= 0; offset >= 0; }
        var start = Storage<Int>.read(MemoryTypeRegistry.fieldStarts, typeId);
        Storage<Int>.write(MemoryTypeRegistry.fieldOffsets, start + index, offset);
        Storage<Bool>.write(MemoryTypeRegistry.fieldIdentity, start + index, containsIdentity);
    }

    function fieldCount(Int typeId) returns Int {
        return Storage<Int>.read(MemoryTypeRegistry.fieldCounts, typeId);
    }
    function fieldOffset(Int typeId, Int index) returns Int {
        var start = Storage<Int>.read(MemoryTypeRegistry.fieldStarts, typeId);
        return Storage<Int>.read(MemoryTypeRegistry.fieldOffsets, start + index);
    }
    function fieldContainsIdentity(Int typeId, Int index) returns Bool {
        var start = Storage<Int>.read(MemoryTypeRegistry.fieldStarts, typeId);
        return Storage<Bool>.read(MemoryTypeRegistry.fieldIdentity, start + index);
    }
    function shutdown() {
        Storage<Int>.release(MemoryTypeRegistry.fieldStarts);
        Storage<Int>.release(MemoryTypeRegistry.fieldCounts);
        Storage<Int>.release(MemoryTypeRegistry.fieldOffsets);
        Storage<Bool>.release(MemoryTypeRegistry.fieldIdentity);
    }
}
