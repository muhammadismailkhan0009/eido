// Compiler-private machine bridge for Eido's managed GC runtime.
//
// Header layout, heap state, allocation, marking, sweeping, and Storage ownership
// live in ManagedGcRuntime.eido. These methods expose only machine operations
// Eido cannot currently express directly.
class ManagedGcNative {
    native function rootHead() returns Int;
    native function rootNext(Int root) returns Int;
    native function rootAllocation(Int root) returns Int;

    native function protectionDepth() returns Int;

    native function trace(
        Int allocation,
        Int payloadOffset,
        Int traceAddress
    );

    native function destroy(
        Int allocation,
        Int payloadOffset,
        Int destroyAddress
    );
}
