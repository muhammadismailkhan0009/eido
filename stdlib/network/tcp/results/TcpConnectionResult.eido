/// Success has a connection; a negative status has no connection.
class TcpConnectionResult {
    Int status;
    TcpConnection? connection;
    invariant { self.valid(); }
    function valid() returns Bool {
        if self.connection exists { return self.status == NetworkStatus.success(); }
        return self.status < 0;
    }
    function failed(Int code) returns TcpConnectionResult {
        require { code < 0; }
        return TcpConnectionResult { status = code; connection = none; };
    }
    function opened(TcpConnection value) returns TcpConnectionResult {
        return TcpConnectionResult { status = NetworkStatus.success(); connection = value; };
    }
}
