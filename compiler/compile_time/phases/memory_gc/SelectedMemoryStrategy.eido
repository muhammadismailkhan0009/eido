// Selected automatic memory strategy.
//
// The compiler chooses this module for --memory=gc. The generic runner knows
// only the stable SelectedMemoryStrategy.plan() contract; mark-and-sweep policy
// lives here rather than in the phase entrypoint.

class SelectedMemoryStrategy {
    function align(Int offset, Int alignment) returns Int {
        return ((offset + alignment - 1) / alignment) * alignment;
    }

    function planType(Int type) {
        var offset = 0;
        var requiredAlignment = 1;
        var fieldIndex = 0;

        while (fieldIndex < TypeInfo.fieldCount(type)) {
            var field = TypeInfo.fieldAt(type, fieldIndex);
            var fieldType = FieldInfo.typeOf(field);
            var fieldAlignment = StorageInfo.alignmentOf(fieldType);

            set offset = SelectedMemoryStrategy.align(
                offset,
                fieldAlignment
            );
            MemoryPlan.field(type, field, offset);

            if (TypeInfo.isManaged(fieldType)) {
                MemoryPlan.trace(type, field);
            }

            set offset = offset + StorageInfo.sizeOf(fieldType);

            if (fieldAlignment > requiredAlignment) {
                set requiredAlignment = fieldAlignment;
            }

            set fieldIndex = fieldIndex + 1;
        }

        MemoryPlan.layout(
            type,
            SelectedMemoryStrategy.align(offset, requiredAlignment),
            requiredAlignment
        );
    }

    function planCallable(Int callable) {
        var parameterIndex = 0;

        while (
            parameterIndex <
            CallableInfo.parameterCount(callable)
        ) {
            var parameter =
                CallableInfo.parameterAt(
                    callable,
                    parameterIndex
                );

            if (
                TypeInfo.isManaged(
                    ValueInfo.typeOf(parameter)
                )
            ) {
                MemoryPlan.root(callable, parameter);
            }

            set parameterIndex = parameterIndex + 1;
        }

        var localIndex = 0;

        while (
            localIndex <
            CallableInfo.localCount(callable)
        ) {
            var local =
                CallableInfo.localAt(
                    callable,
                    localIndex
                );

            if (
                TypeInfo.isManaged(
                    ValueInfo.typeOf(local)
                )
            ) {
                MemoryPlan.root(callable, local);
            }

            set localIndex = localIndex + 1;
        }
    }

    function plan() {
        var typeIndex = 0;

        while (typeIndex < Compiler.typeCount()) {
            SelectedMemoryStrategy.planType(
                Compiler.typeAt(typeIndex)
            );
            set typeIndex = typeIndex + 1;
        }

        var callableIndex = 0;

        while (
            callableIndex <
            Compiler.callableCount()
        ) {
            SelectedMemoryStrategy.planCallable(
                Compiler.callableAt(callableIndex)
            );
            set callableIndex = callableIndex + 1;
        }
    }
}
