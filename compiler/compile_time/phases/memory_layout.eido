// Compiler-standard managed-memory layout phase.
//
// This source is compiled and executed on the build machine. The classes below
// are private compile-time contracts supplied by the compiler host; they are not
// visible to ordinary Eido programs or emitted into application binaries.

class Compiler {
    native function typeCount() returns Int;
    native function typeAt(Int index) returns Int;
}

class TypeInfo {
    native function isManaged(Int type) returns Bool;
    native function fieldCount(Int type) returns Int;
    native function fieldAt(Int type, Int index) returns Int;
}

class FieldInfo {
    native function typeOf(Int field) returns Int;
}

// Private dynamic view over Storage's target-layout authority.
// Ordinary source uses the public Storage<T>.size()/alignment() API instead.
class StorageInfo {
    native function sizeOf(Int type) returns Int;
    native function alignmentOf(Int type) returns Int;
}

// Structured output sink consumed by the compiler after the phase exits.
class MemoryPlan {
    native function field(Int ownerType, Int field, Int offset);
    native function trace(Int ownerType, Int field);
    native function layout(Int type, Int size, Int alignment);
}

function align(Int offset, Int alignment) returns Int {
    return ((offset + alignment - 1) / alignment) * alignment;
}

function planType(Int type) {
    var offset = 0;
    var requiredAlignment = 1;
    var fieldIndex = 0;

    while (fieldIndex < TypeInfo.fieldCount(type)) {
        var field = TypeInfo.fieldAt(type, fieldIndex);
        var fieldType = FieldInfo.typeOf(field);
        var fieldAlignment = StorageInfo.alignmentOf(fieldType);

        set offset = align(offset, fieldAlignment);
        MemoryPlan.field(type, field, offset);

        if (TypeInfo.isManaged(fieldType)) {
            MemoryPlan.trace(type, field);
        }

        set offset = offset + StorageInfo.sizeOf(fieldType);

        if (fieldAlignment > requiredAlignment) {
            set requiredAlignment = fieldAlignment;
        }

        set fieldIndex = fieldIndex + 1;
    }

    MemoryPlan.layout(
        type,
        align(offset, requiredAlignment),
        requiredAlignment
    );
}

function main() {
    var index = 0;

    while (index < Compiler.typeCount()) {
        planType(Compiler.typeAt(index));
        set index = index + 1;
    }
}
