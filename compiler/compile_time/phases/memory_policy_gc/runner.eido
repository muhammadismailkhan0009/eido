// GC policy binds generic compiler event points to ordinary Eido runtime methods.
// The compiler does not know roots, safepoints, collectors, or GC implementation classes.
function main() {
    RuntimeBindings.bind(1, "memoryValueEnter");
    RuntimeBindings.bind(2, "memoryValueUpdate");
    RuntimeBindings.bind(3, "memoryValueLeave");
    RuntimeBindings.bind(4, "memoryTypeRegister");
    RuntimeBindings.bind(5, "memoryTypeSetField");
    RuntimeBindings.bind(6, "memoryObjectAllocate");
    RuntimeBindings.bind(7, "memoryTemporaryEnter");
    RuntimeBindings.bind(8, "memoryTemporaryLeave");
    RuntimeBindings.bind(9, "memoryExecutionBoundary");
    RuntimeBindings.bind(10, "memoryObjectInvariantEnter");
    RuntimeBindings.bind(11, "memoryObjectInvariantLeave");
    RuntimeBindings.bind(12, "memoryObjectInvariantClear");
    RuntimeBindings.bind(13, "memoryShutdown");
}
