class StandardOrderProcessor implements OrderProcessor {
    String channel;

    invariant {
        self.channel != "";
    }

    function process(Order order, String action) returns ProcessingResult {
        if (action == "approve") {
            order.approve();
            return ProcessingResult {
                orderReference = order.reference;
                approved = true;
                message = order.summary() + " via " + self.channel;
            };
        }

        order.reject();
        return ProcessingResult {
            orderReference = order.reference;
            approved = false;
            message = order.summary() + " via " + self.channel;
        };

        ensure {
            result.message == order.summary() + " via " + self.channel;
        }
    }
}
